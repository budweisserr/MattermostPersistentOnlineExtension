{
    "manifest_version": 3,
    "name": "Mattermost Online Status",
    "version": "2025.1.0",
    "action": {
        "default_icon": {
            "128": "icons/favicon.png"
          },
        "default_popup": "popup.html",
        "default_title": "Mattermost Online Status"
    },
    "permissions": [
        "activeTab",
        "storage",
        "cookies",
        "alarms",
        "webRequest"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "mattermost-online-status@nightyonlyy.extension",
            "strict_min_version": "109.0"
        }
    },
    "background": {
        "scripts": ["background.js"]
    }
}