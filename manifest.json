{
    "manifest_version": 3,
    "name": "Mattermost Online Status",
    "version": "2025.1.0",
    "description": "Keeps your Mattermost status online permanently",
    "action": {
        "default_icon": {
            "128": "icons/favicon.png"
        },
        "default_popup": "popup.html",
        "default_title": "Mattermost Online Status"
    },
    "permissions": [
        "activeTab",
        "storage",
        "cookies",
        "alarms",
        "webRequest"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "mattermost-online-status@budweisserr",
            "strict_min_version": "109.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "background": {
        "scripts": ["background.js"]
    }
}
